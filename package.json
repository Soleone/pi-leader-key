{
    "name": "pi-leader-key",
    "version": "1.2.0",
    "description": "Vim-style leader key shortcuts for pi — tap a key sequence to run commands, actions, or shell one-liners.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mmyers0114/pi-leader-key.git"
    },
    "keywords": [
        "pi-package"
    ],
    "type": "module",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "npm run typecheck && tsx --test __tests__/*.test.ts"
    },
    "files": [
        "index.ts",
        "logic.ts",
        "wizard.ts",
        "CHANGELOG.md",
        "AGENTS.md"
    ],
    "pi": {
        "extensions": [
            "index.ts"
        ]
    },
    "peerDependencies": {
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*"
    },
    "devDependencies": {
        "@types/node": "^26.6.4",
        "tsx": "^4.23.13",
        "typescript": "^5.9.3"
    }
}
